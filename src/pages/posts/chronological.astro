---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChildBlogPost from "../../components/ChildBlogPost.astro";
const pageTitle = "Posts and Notes";
const currentPage = "/posts/chronological/";
const allPosts = Object.values(import.meta.glob('./**/*.md', { eager: true }));
// sort by published date (desc)
const sortedPosts = allPosts.sort((a: any, b: any) => a.frontmatter.published > b.frontmatter.published ? -1 : 1);

---
<BaseLayout pageTitle = {pageTitle} currentPage={currentPage}>
    <h1>{pageTitle}</h1>
    <p class="description">
        A collection of my thoughts, logs, and letters to a new friend.<br />
        I try to make this place to be like a digital garden, so some posts here may be incomplete
        or a work in progress. <br />
        I might also rewrite or rephrase occasionally.
    </p>
    <!-- <a href="/posts">See by Category</a> -->
    <ul class="posts">
        {sortedPosts.map((post:any) => 
            <ChildBlogPost url={post.url} title ={post.frontmatter.title} published={post.frontmatter.published} modified={post.frontmatter.modified} />
        )}
    </ul>
</BaseLayout>