---
import BaseLayoutNoNav from "../layouts/BaseLayoutNoNav.astro";
import ChildBlogPost from "../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "./images/see_all_posts.png";
import "../styles/index.css";

const pageTitle = "Home";
const currentPage ="/";
---
<BaseLayoutNoNav pageTitle={pageTitle} currentPage={currentPage}>
	<div id="menu" class="index-content">
		<div class="menu-wrap">
			<a class="" href="/posts/">Posts & Notes</a>
			<a class="" href="/links/">Links</a>
			<a class="" href="/about/">About</a>
		</div>
	</div>
	<div id="latest" class="index-content">
		<h2>Latest</h2>
		<ul class="posts">
			<ChildBlogPost url="/posts/personal/2026-10-22_my_funeral/" title="How I want my funeral to be like" published="2026-10-22"/>
			<ChildBlogPost url="/posts/music/2026-10-20_favorite_songs/" title="Songs I want to I hear again before I die (IOW; my favorites)" published="2026-10-20"/>
			<ChildBlogPost url="/posts/tv-series/2026-10-17_popular_serizawa_acts_weird/" title="I love the casts' interactions, I find my self smiling without knowing: Popular Serizawa Acts Weird Around Me" published="2026-10-17"/>
		</ul>
		<a class="link-to-posts no-decoration" href="/posts/">
			<Image src={seeAllPostsImage} alt="see all posts" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li>『わたしのなかの巨大な星』</li>
				<li>『夜は短し歩けよ乙女』</li>
				<li>『精神はもっと猫背』</li>
				<li>『聖なる怠け者の冒険』</li>
				<li>『えーえんとくちから』</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-album">Albums & EPs</h3>
			<ul>
				<li>AMAZONIA - ONE N' ONLY</li>
				<li>Brotherhood - New Order</li>
				<li>The Walls Are Way Too Thin - Holly Humberstone</li>
				<li>ANIMAL - JO1</li>
				<li>Something We All Got - cootie catcher</li>
				<li>Dear You - Jawbreaker</li>
				<li>SUN - Sammy Rae & The Friends</li>
				<li>Angel - Lizzy McAlpine</li>
				<li>はてな - imase</li>
				<li>Snow Angel - Reneé Rapp</li>
				<li>Men Amongst Mountains - The Revivalists</li>
				<li>My Whole World Ended - David Ruffin</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>GIVE ME FIVE - 川西拓実</li>
				<li>月とあたしと冷蔵庫 - 緑黄色社会</li>
				<li>愛せ、至極散々な僕らの日を - ONE LOVE ONE HEART</li>
				<li>NPC - SUPER ★ DRAGON</li>
				<li>Sex and the city - Audrey Hobert</li>
				<li>結び - Ayumu Imazu</li>
				<li>Chain Reaction - Matilda Mann</li>
				<li>Haunt Me - Matilda Mann</li>
				<li>IGNITE - JO1</li>
				<li>相思想愛 - DXTEEN</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="">TV series</h3>
			<ul>
				<li><a href="/posts/tv-series/2026-10-17_popular_serizawa_acts_weird/">陽キャ集団にいる芹沢は、俺の前だと様子がおかしい(<span style="font-style: italic;">Popular Serizawa Acts Weird Around Me</span>)</a></li>
			</ul>
		</div>
		<!-- <div class="recently-child">
			<h3 class="icon-movie">Movies</h3>
			<ul>
				<li>Backrooms</li>
			</ul>
		</div> -->
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayoutNoNav>