---
import BaseLayoutNoNavJa from "../../layouts/ja/BaseLayoutNoNavJa.astro";
import ChildBlogPost from "../../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "../images/see_all_posts_jpn.png";
import "../../styles/index.css";

const pageTitle = "Home";
const currentJaPage = "/";
---
<BaseLayoutNoNavJa pageTitle={pageTitle} currentPage={currentJaPage}>
	<div id="menu" class="index-content">
		<div class="menu-wrap">
			<a class="" href="/ja/posts/">Posts & Notes</a>
			<a class="" href="/ja/links/">Links</a>
			<a class="" href="/ja/about/">About</a>
		</div>
	</div>
	<div id="latest" class="index-content">
		<h2>更新履歴</h2>
		<ul class="posts">
			<ChildBlogPost url="/ja/posts/lifelog/2026-09-26_abcdxteen/" title="A?B?C?DXTEEN! 好き回リスト" published="2026-09-26"/>
			<ChildBlogPost url="/ja/posts/tv-series/2026-09-25_when_I_fly_towards_you" title="ついつい夜更かしして観てしまった中国ドラマ『向日葵を追いかける太陽』" published="2026-09-25"/>
			<ChildBlogPost url="/ja/posts/photos/2026-09-20_kurashiki/" title="Photos: 倉敷, 2026年3月" published="2026-09-20"/>
		</ul>
		<a class="link-to-posts no-decoration" href="/ja/posts/">
			<Image src={seeAllPostsImage} alt="もっと見る" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li>ジム・アル＝カリーリ、ジョンジョー・マクファデン著『量子力学で生命の謎を解く』</li>
				<li>倉下忠憲著『すべてはノートからはじまる　あなたの人生をひらく記録術』</li>
				<li>稲垣えみ子著『人生はどこでもドア リヨンの14日間』</li>
				<li>森博嗣著『集中力はいらない』</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-album">Albums</h3>
			<ul>
				<li>Take Good Care - The Revivalists</li>
				<li>Kismet - Matilda Mann</li>
				<li>Shallow Hits - Ebbb</li>
				<li>Talk Is Cheap - Keith Richards</li>
				<li>Heard It in a Past Life - Maggie Rogers</li>
				<li>Alone Together - Show Me the Body</li>
				<li>核心触発イノベーション - 原因は自分にある。</li>
				<li>Who's the Clown? - Audrey Hobert</li>
				<li>The Fatal Flaw - Paris Paloma</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>世界はそれを愛と呼ぶんだぜ - サンボマスター</li>
				<li>Funeral - Ashe</li>
				<li>ハルコイ - DXTEEN</li>
				<li>Haunted House - Holly Humberstone</li>
				<li>Friendly Fire - Holly Humberstone</li>
				<li>IGNITE - JO1</li>
				<li>IDOL - DXTEEN</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="">ドラマ</h3>
			<ul>
				<li>修学旅行で仲良くないグループに入りました</li>
				<li>陽キャ集団にいる芹沢は、俺の前だと様子がおかしい</li>
				<li><a href="/ja/posts/tv-series/2026-09-25_when_I_fly_towards_you">当我飞奔向你 (「向日葵を追いかける太陽」)</a></li>
			</ul>
		</div>
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayoutNoNavJa>