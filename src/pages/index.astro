---
import BaseLayoutNoNav from "../layouts/BaseLayoutNoNav.astro";
import ChildBlogPost from "../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "./images/see_all_posts.png";
import "../styles/index.css";

const pageTitle = "Home";
const currentPage ="/";
---
<BaseLayoutNoNav pageTitle={pageTitle} currentPage={currentPage}>
	<div id="menu" class="index-content">
		<div class="menu-wrap">
			<a class="" href="/posts/">Posts & Notes</a>
			<a class="" href="/links/">Links</a>
			<a class="" href="/about/">About</a>
			<a class="rss" href="/feeds/">Feeds</a>
		</div>
	</div>
	<div id="latest" class="index-content">
		<h2>Latest</h2>
		<ul class="posts">
			<ChildBlogPost url="/posts/photos/2026-11-10_old_photos_from_insta/" title="Photos from the days I truly enjoyed using Instagram" published="2026-11-10"/>
			<ChildBlogPost url="/posts/photos/2026-11-06_chiba_ibaraki/" title="Photos: Chiba and Ibaraki, August 2024" published="2026-11-06"/>
			<ChildBlogPost url="/posts/music/2026-11-03_the_walls_are_way_too_thin/" title=`Okay, I love this too; "The Walls Are Way Too Thin" (EP)` published="2026-11-03"/>
		</ul>
		<a class="link-to-posts no-decoration" href="/posts/">
			<Image src={seeAllPostsImage} alt="see all posts" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li>森見登美彦『走れメロス』</li>
				<li>永井玲衣『これがそうなのか』</li>
				<li>コーマック・マッカーシー『ザ・ロード』
					<br>Japanese translation of <span style="font-style: italic;">The Road</span> by Cormac McCarthy
				</li>
				<li>小林秀雄『読書について』</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-album">Albums & EPs</h3>
			<ul>
				<li><span style="font-style:italic">H2O</span> - Daryl Hall & John Oates</li>
				<li><span style="font-style:italic">tomorrow</span> - 川西拓実</li>
				<li><span style="font-style:italic">Searchin' for a Rainbow</span> - The Marshall Tucker Band</li>
				<li><span style="font-style:italic">The Smoker You Drink, The Player You Get</span> - Joe Walsh</li>
				<li><span style="font-style:italic">Ga Ga Ga Ga Ga (Bonus Track Version)</span> - Spoon</li>
				<li><span style="font-style:italic">PRE PLEASURE</span> - Julia Jacklin</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>ラブリーズン - 原因は自分にある。</li>
				<li>いいんじゃない - muque</li>
				<li>Hands On Me - Maisie Peters</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-tv">TV series</h3>
			<ul>
				<li>『南田南弁護士は天才肌』(<span style="font-style: italic;">Extraordinary Attorney Minami</span>)</li>
				<li>『メリーベリーラブ』(<span style="font-style: italic;">Merry Berry Love</span>)</li>
				<li>『修学旅行で仲良くないグループに入りました2 』(<span style="font-style: italic;">School Trip: Joined a Group I'm Not Close To Season 2</span>)</li>
				<li>『青と碧』(<span style="font-style: italic;">Ao to Midori</span>)</li>
			</ul>
		</div>
		<!-- <div class="recently-child">
			<h3 class="icon-movie">Movies</h3>
			<ul>
				<li>Backrooms</li>
			</ul>
		</div> -->
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayoutNoNav>