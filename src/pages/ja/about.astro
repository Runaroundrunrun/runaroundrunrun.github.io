---
import BaseLayoutJa from "../../layouts/ja/BaseLayoutJa.astro";
import { Image } from 'astro:assets';
import profileImage from "../images/profile_umbrella.png";
import "../../styles/about.css";
const pageTitle = "About";
const currentJaPage = "/about/"
---

<BaseLayoutJa pageTitle={pageTitle} currentPage={currentJaPage}>
    <h1>{pageTitle}</h1>
    <div class="about-container">
        <h2>Runa's Playground へようこそ!</h2>
        <span>この Web サイトは</span>
        <ul>
            <li>サイト作成者がいろいろ試して遊ぶために作っています。</li>
            <li>書いた文章や作ったものの保管庫にもなる予定です。</li>
        </ul>
    </div>

    <div class="profile-container about-container">
        <Image src={profileImage} alt="profile image" layout="constrained"/>
        <div>
            <h2>ちょっとしたプロフィール</h2>
            <ul>
                <li>
                    旅行や知らない場所を訪れること、読書、そして手帳を眺めたり書くのが好き
                </li>
                <li>前職ではコードを書いていたけど、仕事は一旦ストップ中</li>
                <li>日本のどこかに住んでる</li>
                <li>
                    いっつも言語学習のトピックに惹かれてる。
                    今かじっている言語は、
                    <ul>
                        <li>英語</li>
                        <li>フランス語</li>
                        <li>中国語</li>
                    </ul>
                </li>
                <li>ちゃんと大人になりたい</li>
                <li>でもよく先延ばししてしまう</li>
                <li>絵がうまくなりたい</li>
            </ul>
        </div>
    </div>
    <div class="about-container">
        <h3>Contact</h3>
        <p class="icon-books ">読書メーター<a href="https://bookmeter.com/users/1506527" class="icon-new-tab" style="margin-left:1em">Rangrang</a></p>
        <p class="icon-mail">suzuki-runa@proton.me</p>
    </div>
</BaseLayoutJa>
