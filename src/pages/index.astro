---
import BaseLayoutNoNav from "../layouts/BaseLayoutNoNav.astro";
import ChildBlogPost from "../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "./images/see_all_posts.png";
import "../styles/index.css";

const pageTitle = "Home";
const currentPage ="/";
---
<BaseLayoutNoNav pageTitle={pageTitle} currentPage={currentPage}>
	<div id="menu" class="index-content">
		<div class="menu-wrap">
			<a class="" href="/posts/">Posts & Notes</a>
			<a class="" href="/links/">Links</a>
			<a class="" href="/about/">About</a>
			<a class="rss" href="/feeds/">Feeds</a>
		</div>
	</div>
	<div id="latest" class="index-content">
		<h2>Latest</h2>
		<ul class="posts">
			<ChildBlogPost url="/posts/lifelog/2026/november_media_log/" title="Media Log (November 2026)" published="2026-12-01"/>
			<ChildBlogPost url="/posts/bookmarks/2026-11-28_inspiring_posts_about_writing/" title="Bookmarks: posts that inspired me to write and keep writing" published="2026-11-28"/>
			<ChildBlogPost url="/posts/personal/2026-11-21_thoughts_on_being_online/" title="I should be offline more" published="2026-11-21"/>
		</ul>
		<a class="link-to-posts no-decoration" href="/posts/">
			<Image src={seeAllPostsImage} alt="see all posts" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="child-container">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li>森見登美彦『走れメロス』</li>
				<li>永井玲衣『これがそうなのか』</li>
				<li>コーマック・マッカーシー『ザ・ロード』
					<br>Japanese translation of <span style="font-style: italic;">The Road</span> by Cormac McCarthy
				</li>
				<li>小林秀雄『読書について』</li>
				<li>ソン・ウォンピョン『アーモンド』
					<br>Japanese translation of <span style="font-style: italic;">Almond</span> by Sohn Won-pyung
				</li>
				<li><span style="font-style: italic;">The Unabridged Journals of Sylvia Plath</span> edited by Karen V. Kukil</li>
				<li>サラ・ヘンドリックス『自閉スペクトラム症の女の子が出会う世界 : 幼児期から老年期まで』
					<br>Japanese translation of <span style="font-style: italic;">Women and girls on the autism spectrum : understanding life experiences from early childhood to old age</span> by Sarah Hendrickx
				</li>
			</ul>
		</div>
		<div class="child-container">
			<h3 class="icon-tv">TV series</h3>
			<ul>
				<li>『南田南弁護士は天才肌』(<span style="font-style: italic;">Extraordinary Attorney Minami</span>)</li>
				<li>『メリーベリーラブ』(<span style="font-style: italic;">Merry Berry Love</span>)</li>
				<li>『修学旅行で仲良くないグループに入りました2 』(<span style="font-style: italic;">School Trip: Joined a Group I'm Not Close To Season 2</span>)</li>
				<li>『青と碧』(<span style="font-style: italic;">Ao to Midori</span>)</li>
			</ul>
		</div>
		<!-- <div class="child-container">
			<h3 class="icon-movie">Movies</h3>
			<ul>
				<li>Backrooms</li>
			</ul>
		</div> -->
	</div>
	<!-- <div id="collections">

	</div> -->
	<div id="music" class="index-content">
		<h2>Music I've been listening to</h2>
		<div class="child-container">
			<h3 class="icon-album">Albums & EPs</h3>
			<ul>
				<li><span style="font-style:italic">Ga Ga Ga Ga Ga (Bonus Track Version)</span> - Spoon</li>
				<li><span style="font-style:italic">PRE PLEASURE</span> - Julia Jacklin</li>
				<li><span style="font-style:italic">Cruel World...So It Ends</span> - Holly Humberstone</li>
				<li><span style="font-style:italic">Lab.</span> - go!go!vanillas</li>
				<li><span style="font-style:italic">Give Me A Minute</span> - Lizzy McAlpine</li>
				<li><span style="font-style:italic">Being Funny In A Foreign Language</span> - The 1975</li>
				<li><span style="font-style:italic">Every Bad (Expanded Edition)</span> - Porridge Radio</li>
				<li><span style="font-style:italic">Jump Rope Gazers</span> - The Beths</li>
			</ul>
		</div>
		<div class="child-container">
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>Pharmacist - Alvvays</li>
				<li>Easy On Your Own? - Alvvays</li>
				<li>Belinda Says - Alvvays</li>
				<li>トリックスター - go!go!vanillas</li>
			</ul>
			<p>Wanna listen to my recent favorites on <a class="icon-new-tab" target="_blank" href="https://www.last.fm/user/runaroundrun/playlists/14629825">Last.fm</a> (or <a class="icon-new-tab" target="_blank" href="https://open.spotify.com/playlist/7meM628kNE3Z0GudmbKqp2?si=Abeu0BAQQ6GTnf24SbIJXg">Spotify</a>) ?</p>
		</div>
	</div>
</BaseLayoutNoNav>