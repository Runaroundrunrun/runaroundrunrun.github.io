---
import BaseLayoutJa from "../../layouts/ja/BaseLayoutJa.astro"
import ChildBlogPost from "../../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "../images/see_all_posts_jpn.png";
import "../styles/index.css";

const pageTitle = "Home"
---
<BaseLayoutJa pageTitle={pageTitle}>
	<div class="lang-switch">
		<a href="/">English</a>
	</div>
	<div id="latest" class="index-content">
		<h2>更新履歴</h2>
		<ul class="posts">
			<ChildBlogPost url="/ja/posts/web-dev/2026-06-10_setting_iframe_css" title="画面を縮小したら親要素から動画がはみ出る問題の対応" published="2026-06-10" />
			<ChildBlogPost url="/ja/posts/lifelog/2026/2026_may_media_log" title="2026年5月に楽しんだ作品リスト" published="2026-06-06" />
			<ChildBlogPost url="/ja/posts/technical/2026-06-06_keyboard_shortcuts" title="使っているショートカットキー" published="2026-06-06" />
		</ul>
		<a class="link-to-posts" href="/ja/posts">
			<Image src={seeAllPostsImage} alt="もっと見る" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-music">Music</h3>
			<ul>
				<li class="icon-album">Albums</li>
					<ul>
						<li>Florescense - Masie Peters</li>
					</ul>
				<li>Songs</li>
				<ul>
					<li>Wanna Buy A Plant + Cost Me - JO1, Anderson .Paak</li>
					<li>景色 - JO1.VER - JO1</li>
					<li>doomsday - Lizzy McAlpine</li>
				</ul>
			</ul>
		</div>
		<div class="recently-child">
			<h3>Netflix Series</h3>
			<ul>
				<li>ザ・ボローズ</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li>『火星の人』</li>
			</ul>
		</div>
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayoutJa>