---
import BaseLayoutJa from "../../layouts/ja/BaseLayoutJa.astro"
import ChildBlogPost from "../../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "../images/see_all_posts_jpn.png";
import "../../styles/index.css";

const pageTitle = "Home";
const currentJaPage = "/";
---
<BaseLayoutJa pageTitle={pageTitle} currentPage={currentJaPage}>
	<div id="latest" class="index-content">
		<h2>更新履歴</h2>
		<ul class="posts">
			<ChildBlogPost url="/ja/posts/lifelog/2026/2026_august_media_log" title="2026年8月に消費したメディア記録" published="2026-08-30"/>
			<ChildBlogPost url="/ja/posts/photos/2026-08-24_izumo" title="Photos: 出雲, 2025年3月" published="2026-08-24"/>
			<ChildBlogPost url="/ja/posts/writing/2026-08-23_stopped_using_AI_for_writing" title="英語記事を書くときにAIで添削するのをやめた" published="2026-08-23"/>
		</ul>
		<a class="link-to-posts no-decoration" href="/ja/posts/">
			<Image src={seeAllPostsImage} alt="もっと見る" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li>コーディー・キャシディー、ポール・ドハティー 著、『とんでもない死に方の科学』</li>
				<li>ジョージア・ブラッグ 著、『偉人たちのあんまりな死に方』</li>
				<li>ピーター・クレイン 著、『イチョウ　奇跡の２億年史』</li>
				<li>西牟田靖 著、『本で床は抜けるのか』</li>
				<li>今村昌弘 著、『屍人荘の殺人』</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="">Games</h3>
			<ul>
				<li>Dave the Diver</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-album">Albums</h3>
			<ul>
				<li>Get It Honest - The Revivalists</li>
				<li>À TOUS LES BÂTARDS - Eddy de Pretto</li>
				<li>Foreign Tongues - The Rolling Stones</li>
				<li>GNX - Kendrick Lamar</li>
				<li>Lost Weekend - Phoebe Bridgers</li>
				<li>Paint My Bedroom Black - Holly Humberstone</li>
				<li>The Ground Above - Beth Orton</li>
				<li>Loveland - Suki Waterhouse</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>After The Love - Matilda Mann</li>
				<li>Ramblin' - The Marshall Tucker Band</li>
				<li>WHATCHA DOIN - JO1</li>
				<li>The Walls Are Way Too Thin - Holly Humberstone</li>
				<li>firearm - Lizzy McAlpine</li>
				<li>Stop the Wedding! - Ashe</li>
				<li>These Days(feat. Jess Glynne, Macklemore & Dan Caplen) - Rudimental</li>
				<li>トレモロ - 原因は自分にある。</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="">TV series</h3>
			<ul>
				<li>修学旅行で仲良くないグループに入りました</li>
			</ul>
		</div>
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayoutJa>