---
import BaseLayout from "../layouts/BaseLayout.astro"
import ChildBlogPost from "../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "./images/see_all_posts.png";
import "../styles/index.css";

const pageTitle = "Home";
const currentPage ="/";
---
<BaseLayout pageTitle={pageTitle} currentPage={currentPage}>
	<div id="latest" class="index-content">
		<h2>Latest</h2>
		<ul class="posts">
			<ChildBlogPost url="/posts/lifelog/2026-08-27_film_camera" title="My Favorite Belonging: KODAK Film Camera M38" published="2026-08-27"/>
			<ChildBlogPost url="/posts/writing/2026-08-24_think_on_paper" title="Note to self: please think on paper, for goodness' sake" published="2026-08-24"/>
			<ChildBlogPost url="/posts/web-dev/2026-08-21_adding_links_page" title="Update: added Links page" published="2026-08-21"/>
		</ul>
		<a class="link-to-posts no-decoration" href="/posts/">
			<Image src={seeAllPostsImage} alt="see all posts" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li>『とんでもない死に方の科学』
					<br>Japanese version of <span style="font-style: italic;">And Then You're Dead : What Really Happens If You Get Swallowed by a Whale, Are Shot from a Cannon, or Go Barreling over Niagara</span> by Cody Cassidy, Paul Doherty
				</li>
				<li>『偉人たちのあんまりな死に方』
					<br>Japanese version of <span style="font-style: italic;">How They Croaked: The Awful Ends of the Awfully Famous</span> by Georgia Bragg
				</li>
				<li>『イチョウ　奇跡の２億年史』
					<br>Japanese version of <span style="font-style: italic;">Ginkgo : the tree that time forgot</span> by Peter Crane
				</li>
				<li>『本で床は抜けるのか』</li>
				<li>『屍人荘の殺人』</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="">Games</h3>
			<ul>
				<li>Dave the Diver</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-album">Albums</h3>
			<ul>
				<li>Get It Honest - The Revivalists</li>
				<li>À TOUS LES BÂTARDS - Eddy de Pretto</li>
				<li>Foreign Tongues - The Rolling Stones</li>
				<li>GNX - Kendrick Lamar</li>
				<li>Lost Weekend - Phoebe Bridgers</li>
				<li>Paint My Bedroom Black - Holly Humberstone</li>
				<li>The Ground Above - Beth Orton</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>After The Love - Matilda Mann</li>
				<li>Ramblin' - The Marshall Tucker Band</li>
				<li>WHATCHA DOIN - JO1</li>
				<li>The Walls Are Way Too Thin - Holly Humberstone</li>
				<li>firearm - Lizzy McAlpine</li>
				<li>Stop the Wedding! - Ashe</li>
				<li>These Days(feat. Jess Glynne, Macklemore & Dan Caplen) - Rudimental</li>
				<li>トレモロ - 原因は自分にある。</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="">TV series</h3>
			<ul>
				<li>修学旅行で仲良くないグループに入りました</li>
			</ul>
		</div>
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayout>