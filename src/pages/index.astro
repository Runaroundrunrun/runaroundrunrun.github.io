---
import BaseLayout from "../layouts/BaseLayout.astro"
import ChildBlogPost from "../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "./images/see_all_posts.png";
import "../styles/index.css";

const pageTitle = "Home";
const currentPage ="/";
---
<BaseLayout pageTitle={pageTitle} currentPage={currentPage}>
	<div id="latest" class="index-content">
		<h2>Latest</h2>
		<ul class="posts">
			<ChildBlogPost url="/posts/stationery/2026-07-27_sokuryo_yacho" title="KOKUYO Sokuryo Yacho - a perfect pocket notebook for me to carry around" published="2026-07-27"/>
			<ChildBlogPost url="/posts/music/2026-07-16_cruel_world" title="My new favourite album : Cruel World by Holly Humberstone" published="2026-07-16"/>
			<ChildBlogPost url="/posts/photos/2026-07-11_hydrangeas" title="Photos : hydrangeas" published="2026-07-11"/>
		</ul>
		<a class="link-to-posts no-decoration" href="/posts/">
			<Image src={seeAllPostsImage} alt="see all posts" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-album">Albums</h3>
			<ul>
				<li><a href="/posts/music/2026-07-16_cruel_world">Cruel World - Holly Humberstone</a></li>
				<li>Stars And Teeth - Sophie May</li>
				<li>Hotel TV - Lawrence</li>
				<li>Ooh La La - Faces</li>
			</ul>
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>うるわしきひと - いきものがかり</li>
				<li>Stargaze - SixTONES</li>
				<li>こっから - SixTONES</li>
				<li>There Will Never Be Another You - Matilda Mann</li>
				<li>10 ans de nous - Live (Seul en scène) - Ben Mazué</li>
				<li>Freaks - Eddy de Pretto</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-movie">Movies</h3>
			<ul>
				<li>Enola Holmes 3</li>
				<li>Catch Me If You Can</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li>『人間をお休みしてヤギになってみた結果』</li>
				Japanese version of <span style="font-style:italic">GoatMan: How I Took a Holiday from Being Human</span> by Thomas Thwaites
				<li>『強いビジネスパーソンを目指して鬱になった僕の 弱さ考』</li>
			</ul>
		</div>
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayout>