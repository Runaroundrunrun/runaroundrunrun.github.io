---
import BaseLayoutJa from "../../layouts/ja/BaseLayoutJa.astro"
import ChildBlogPost from "../../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "../images/see_all_posts_jpn.png";
import "../../styles/index.css";

const pageTitle = "Home";
const currentJaPage = "/";
---
<BaseLayoutJa pageTitle={pageTitle} currentPage={currentJaPage}>
	<div id="latest" class="index-content">
		<h2>更新履歴</h2>
		<ul class="posts">
			<ChildBlogPost url="/ja/posts/lifelog/2026/2026_june_media_log" title="2026年6月に楽しんだ作品リスト" published="2026-07-28"/>
			<ChildBlogPost url="/ja/posts/web-dev/2026-07-27_create_astro_project" title="Webサイト立ち上げの記録(3) - Astro を使ったプロジェクトの作成" published="2026-07-27"/>
			<ChildBlogPost url="/ja/posts/reading/2026-07-26_goatman" title="やっぱり笑える!『人間をお休みしてヤギになってみた結果』" published="2026-07-26"/>
		</ul>
		<a class="link-to-posts no-decoration" href="/ja/posts/">
			<Image src={seeAllPostsImage} alt="もっと見る" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-album">Albums</h3>
			<ul>
				<li>Cruel World - Holly Humberstone</li>
				<li>Stars And Teeth - Sophie May</li>
				<li>Hotel TV - Lawrence</li>
				<li>Ooh La La - Faces</li>
			</ul>
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>うるわしきひと - いきものがかり</li>
				<li>Stargaze - SixTONES</li>
				<li>こっから - SixTONES</li>
				<li>There Will Never Be Another You - Matilda Mann</li>
				<li>10 ans de nous - Live (Seul en scène) - Ben Mazué</li>
				<li>Freaks - Eddy de Pretto</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-movie">Movies</h3>
			<ul>
				<li>Enola Holmes 3</li>
				<li>Catch Me If You Can</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li><a href="/ja/posts/reading/2026-07-26_goatman">『人間をお休みしてヤギになってみた結果』</a></li>
				<li>『強いビジネスパーソンを目指して鬱になった僕の 弱さ考』</li>
			</ul>
		</div>
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayoutJa>