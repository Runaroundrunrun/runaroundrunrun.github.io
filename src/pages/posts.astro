---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChildBlogPost from "../components/ChildBlogPost.astro";
import type { MarkdownInstance } from 'astro';

interface Frontmatter {
    layout: string,
    title: string,
    published: string,
    modified?: string,
    lang: string,
    category?: string
}

const pageTitle = "Posts and Notes";
const currentPage = "/posts/";

const allPosts = Object.values(import.meta.glob<MarkdownInstance<Frontmatter>>('./posts/**/*.md', { eager: true }));
// sort by published date (desc)
const sortedPosts = allPosts.sort((a: any, b: any) => a.frontmatter.published > b.frontmatter.published ? -1 : 1);
const byCategory = Map.groupBy(sortedPosts, (post) => {return post.frontmatter.category as string});
// sort categories alphabetically
const categories = [...byCategory.keys()].sort();

const categoryDispMap: Record<string, string> = {
    "crafting" : "Crafting",
    "lifelog" : "Lifelog",
    "music" : "Music",
    "photos" : "Photos",
    "reading" : "Reading",
    "technical" : "Technical",
    "tv-series" : "TV series",
    "web-dev" : "Website Development",
    "writing" : "Writing"
};
const categoryIconMap: Record<string, string> = {
    "crafting" : "",
    "lifelog" : "",
    "music" : "icon-music",
    "photos" : "icon-camera",
    "reading" : "icon-books",
    "technical" : "",
    "tv-series" : "",
    "web-dev" : "",
    "writing" : ""
};

---

<BaseLayout pageTitle={pageTitle} currentPage={currentPage}>
    <h1>{pageTitle}</h1>
    <p class="description">
        A collection of my thoughts, logs, and letters to a new friend.<br />
        I try to make this place to be like a digital garden, so some posts here may be incomplete
        or a work in progress. <br />
        I might also rewrite or rephrase occasionally.
    </p>
    <div class="categories-and-posts">
        <aside class="categories">
            <nav>
                <h4>Categories</h4>
                <ul>
                    {categories.map(category => 
                        <li><a href={`#${category}`}>{categoryDispMap[category]}</a></li>
                    )}
                </ul>
            </nav>
        </aside>
        <div class="posts-container">
            {categories.map(category => {
                return (
                    <div id={category} class="posts-category">
                        <h3 class={categoryIconMap[category]}>{categoryDispMap[category]}</h3>
                        <ul class="posts">
                            {byCategory.get(category)?.map(
                                (post) => {return (
                                    <ChildBlogPost url={post.url} title={post.frontmatter.title} published={post.frontmatter.published} modified={post.frontmatter.modified}/>   
                                )}
                            )}
                        </ul>
                    </div>
                )
            })}
        </div>
    </div>
</BaseLayout>
