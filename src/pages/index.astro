---
import BaseLayout from "../layouts/BaseLayout.astro"
import ChildBlogPost from "../components/ChildBlogPost.astro";
const pageTitle = "Home"
---
<BaseLayout pageTitle={pageTitle}>
	<div class="lang-switch">
		<a href="/ja/">にほんご / Japanese</a>
	</div>
	<div id="latest" class="index-content">
		<h2>Latest</h2>
		<ul class="posts">
			<ChildBlogPost url="/posts/web-dev/2026-05-20_features_to_add" title="Features I want to add to this website" published="2026-05-20" />
			<ChildBlogPost url="/posts/reading/2026-05-16_I_buy_way_more_books_than_I_can_read" title="I buy way more books than I can read" published="2026-05-16" />
			<ChildBlogPost url="/posts/tv-series/2026-05-13_yumis_cells3" title="I haven't felt this happy watching a Korean series - 유미의 세포들 3 (Yumi's Cells 3)" published="2026-05-13" />
		</ul>
		<a href="/posts/by-date/">and more...</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3>Music</h3>
			<ul>
				<li>Albums</li>
					<ul>
						<li>Roxwell - Matilda Mann</li>
						<li>SABLE, fABLE - Bon Iver</li>
						<li>Famille - Ben Mazué</li>
					</ul>
				<li>Songs</li>
				<ul>
					<li>The Fig Tree - Matilda Mann</li>
					<li>IF I - I.O.I</li>
					<li>Suddenly - I.O.I</li>
					<li>BOOMPALA - LE SSERAFIM</li>
				</ul>
			</ul>
		</div>
		<div class="recently-child">
			<h3>Movie</h3>
			<ul>
				<li>The Mandalorian and Grogu (2026)</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3>Book</h3>
			<ul>
				<li>Project Hail Mary</li>
			</ul>
		</div>
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayout>