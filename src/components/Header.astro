---
import Navigation from "./Navigation.astro";
const {lang, currentPage} = Astro.props;
const home = lang == "ja" ? "/ja/" : "/";
const currentLangPage = (lang != "ja" ? "/ja" : "") + currentPage;
const langDisp = lang != "ja" ? "にほんご" : "English";
const langVisibility = currentPage == null ? "invisible" : "";
---

<header>
  <div class="container">
    <a class="logo no-decoration" href={home}><img src="/images/logo.png" alt="logo Runa's Playground"/></a>
    <div class="lang">
      <a class={langVisibility} href={currentLangPage}>{langDisp}</a>
    </div>
  </div>
  <nav>
    <Navigation lang={lang}/>
  </nav>
</header>
