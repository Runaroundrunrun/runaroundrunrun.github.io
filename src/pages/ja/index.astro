---
import BaseLayoutJa from "../../layouts/ja/BaseLayoutJa.astro"
import ChildBlogPost from "../../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "../images/see_all_posts_jpn.png";
import "../../styles/index.css";

const pageTitle = "Home";
const currentJaPage = "/";
---
<BaseLayoutJa pageTitle={pageTitle} currentPage={currentJaPage}>
	<div id="latest" class="index-content">
		<h2>更新履歴</h2>
		<ul class="posts">
			<ChildBlogPost url="/ja/posts/cooking/2026-07-04_recipe_minestrone" title="レシピ: ミネストローネ" published="2026-07-04"/>
			<ChildBlogPost url="/ja/posts/web-dev/2026-07-03_adding_categories_section" title="categories セクションを Posts and Notes ページに追加" published="2026-07-03"/>
			<ChildBlogPost url="/ja/posts/reading/2026-07-01_books_I_want_to_read" title="読みたい本リスト" published="2026-07-01" />
		</ul>
		<a class="link-to-posts no-decoration" href="/ja/posts/chronological">
			<Image src={seeAllPostsImage} alt="もっと見る" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-album">Albums</h3>
			<ul>
				<li>Cruel World - Holly Humberstone</li>
			</ul>
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>うるわしきひと - いきものがかり</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-movie">Movies</h3>
			<ul>
				<li>エノーラ・ホームズの事件簿3</li>
				<li>キャッチ・ミー・イフ・ユー・キャン</li>
			</ul>
		</div>
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayoutJa>