---
import BaseLayoutJa from "../../layouts/ja/BaseLayoutJa.astro";
import ChildBlogPost from "../../components/ChildBlogPost.astro";
const pageTitle = "Posts and Notes";
---

<BaseLayoutJa pageTitle = {pageTitle}>
	<div class="lang-switch">
		<a href="/posts/">English</a>
	</div>
    <h1>{pageTitle}</h1>
    <div id="crafting" class="posts-category">
        <h3>ハンドクラフト</h3>
        <ul class="posts">
            <ChildBlogPost url="/posts/crafting/2026-05-26_decorating_notebook_covers" title="Decorating notebook covers" published="2026-05-26" />
        </ul>
    </div>
    <div id="lifelog" class="posts-category">
        <h3>ライフログ</h3>
        <ul class="posts">
            <ChildBlogPost url="/posts/lifelog/2026/2026_may_media_log" title="Media Log (May 2026)" published="2026-06-03"/>
        </ul>
    </div>
    <div id="reading" class="posts-category">
        <h3>読書</h3>
        <ul class="posts">
            <ChildBlogPost url="/posts/reading/2026-05-16_I_buy_way_more_books_than_I_can_read" title="I buy way more books than I can read" published="2026-05-16" />
        </ul>
    </div>
    <div id="technical">
        <h3>Technical</h3>
        <ul class="posts">
            <ChildBlogPost url="/posts/technical/2026-05-30_keyboard_shortcuts" title="Keyboard shortcuts I use" published="2026-05-30"/>
        </ul>
    </div>
    <div id="tv-series" class="posts-category">
        <h3>ドラマ</h3>
        <ul class="posts">
            <ChildBlogPost url="/posts/tv-series/2026-05-13_yumis_cells3" title="I haven't felt this happy watching a Korean series - 유미의 세포들 3 (Yumi's Cells 3)" published="2026-05-13" modified="2026-05-24" />
        </ul>
    </div>
    <div id="website-dev" class="posts-category">
        <h3>Webサイト開発</h3>
        <ul class="posts">
            <ChildBlogPost url="/ja/posts/web-dev/2026-05-30_features_to_add" title="このサイトに加えたい機能" published="2026-05-30" />
            <ChildBlogPost url="/ja/posts/web-dev/2026-05-20_on_setting_up_this_website" title="ウェブサイトを立ち上げてみた" published="2026-05-20"/>
            <ChildBlogPost url="/posts/web-dev/2026-05-12_my_current_vscode_keybindings_configuration" title="My current keybindings configuration in VSCode" published="2026-05-12" />
        </ul>
    </div>
</BaseLayoutJa>
