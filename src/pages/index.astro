---
import BaseLayoutNoNav from "../layouts/BaseLayoutNoNav.astro";
import ChildBlogPost from "../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "./images/see_all_posts.png";
import "../styles/index.css";

const pageTitle = "Home";
const currentPage ="/";
---
<BaseLayoutNoNav pageTitle={pageTitle} currentPage={currentPage}>
	<div id="menu" class="index-content">
		<div class="menu-wrap">
			<a class="" href="/posts/">Posts & Notes</a>
			<a class="" href="/links/">Links</a>
			<a class="" href="/about/">About</a>
		</div>
	</div>
	<div id="latest" class="index-content">
		<h2>Latest</h2>
		<ul class="posts">
			<ChildBlogPost url="/posts/movies/2026-09-30_backrooms/" title="Backrooms(movie)" published="2026-09-30"/>
			<ChildBlogPost url="/posts/writing/2026-09-26_why_I_write/" title="Why do I write? Do I even like writing?" published="2026-09-26"/>
			<ChildBlogPost url="/posts/music/2026-09-20_discovering_new_music/" title="How I discover new music" published="2026-09-20"/>
		</ul>
		<a class="link-to-posts no-decoration" href="/posts/">
			<Image src={seeAllPostsImage} alt="see all posts" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li>『量子力学で生命の謎を解く』
					<br>Japanese version of <span style="font-style: italic;">Life on the Edge: The Coming of Age of Quantum Biology</span> by Jim Al-Khalili, Johnjoe McFadden
				</li>
				<li>『すべてはノートからはじまる　あなたの人生をひらく記録術』</li>
				<li>『人生はどこでもドア リヨンの14日間』</li>
				<li>『集中力はいらない』</li>
				<li>『増補 普通の人びと ホロコーストと第101警察予備大隊』
					<br>Japanese translation of <span style="font-style: italic;">Ordinary men : reserve police battalion 101 and the final solution in Poland</span> by Christopher R. Browning
				</li>
				<li>『ルポ　ゴミ屋敷に棲む人びと』</li>
				<li>『ほんとうのことを書く練習』</li>
				<li>『わたしのなかにある巨大な星』</li>
				<li>『深夜0時の司書見習い』</li>
				<li>『自省録』
					<br>Japanese version of <span style="font-style: italic;">Meditations</span> by Marcus Aurelius
				</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-album">Albums</h3>
			<ul>
				<li>Take Good Care - The Revivalists</li>
				<li>Kismet - Matilda Mann</li>
				<li>Shallow Hits - Ebbb</li>
				<li>Talk Is Cheap - Keith Richards</li>
				<li>Heard It in a Past Life - Maggie Rogers</li>
				<li>Alone Together - Show Me the Body</li>
				<li>核心触発イノベーション - 原因は自分にある。</li>
				<li>Who's the Clown? - Audrey Hobert</li>
				<li>The Fatal Flaw - Paris Paloma</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>世界はそれを愛と呼ぶんだぜ - サンボマスター</li>
				<li>Funeral - Ashe</li>
				<li>ハルコイ - DXTEEN</li>
				<li>Haunted House - Holly Humberstone</li>
				<li>Friendly Fire - Holly Humberstone</li>
				<li>IGNITE - JO1</li>
				<li>IDOL - DXTEEN</li>
				<li>Celebration - The Revivalists</li>
				<li>Yes! 東京 - EBiDAN(恵比寿学園男子部)</li>
				<li>GIVE ME FIVE - 川西拓実</li>
				<li>月とあたしと冷蔵庫 - 緑黄色社会</li>
				<li>愛せ、至極散々な僕らの日を - ONE LOVE ONE HEART</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="">TV series</h3>
			<ul>
				<li>修学旅行で仲良くないグループに入りました</li>
				<li>陽キャ集団にいる芹沢は、俺の前だと様子がおかしい</li>
				<li>当我飞奔向你 (When I Fly Towards You)</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-movie">Movies</h3>
			<ul>
				<li>Backrooms</li>
			</ul>
		</div>
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayoutNoNav>