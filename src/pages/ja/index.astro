---
import BaseLayoutJa from "../../layouts/ja/BaseLayoutJa.astro"
import ChildBlogPost from "../../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "../images/see_all_posts_jpn.png";
import "../../styles/index.css";

const pageTitle = "Home";
const currentJaPage = "/";
---
<BaseLayoutJa pageTitle={pageTitle} currentPage={currentJaPage}>
	<div id="latest" class="index-content">
		<h2>更新履歴</h2>
		<ul class="posts">
			<ChildBlogPost url="/ja/posts/music/2026-08-06_cruel_world" title="新しいお気に入りアルバム: Holly Humberstone の Cruel World" published="2026-08-06"/>
			<ChildBlogPost url="/ja/posts/photos/2026-08-05_hydrangeas" title="Photos : アジサイ" published="2026-08-05"/>
			<ChildBlogPost url="/ja/posts/drawing/2026-08-03_sketches" title="スケッチ (2026.06.24 - 06.26)" published="2026-08-03"/>
		</ul>
		<a class="link-to-posts no-decoration" href="/ja/posts/">
			<Image src={seeAllPostsImage} alt="もっと見る" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="">Games</h3>
			<ul>
				<li>Dave the Diver</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-album">Albums</h3>
			<ul>
				<li>Get It Honest - The Revivalists</li>
				<li>À TOUS LES BÂTARDS - Eddy de Pretto</li>
				<li>Foreign Tongues - The Rolling Stones</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>After The Love - Matilda Mann</li>
				<li>Ramblin' - The Marshall Tucker Band</li>
				<li>WHATCHA DOIN - JO1</li>
			</ul>
		</div>
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayoutJa>