---
import BaseLayoutNoNavJa from "../../layouts/ja/BaseLayoutNoNavJa.astro";
import ChildBlogPost from "../../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "../images/see_all_posts_jpn.png";
import "../../styles/index.css";

const pageTitle = "Home";
const currentJaPage = "/";
---
<BaseLayoutNoNavJa pageTitle={pageTitle} currentPage={currentJaPage}>
	<div id="menu" class="index-content">
		<div class="menu-wrap">
			<a class="" href="/ja/posts/">Posts & Notes</a>
			<a class="" href="/ja/links/">Links</a>
			<a class="" href="/ja/about/">About</a>
		</div>
	</div>
	<div id="latest" class="index-content">
		<h2>更新履歴</h2>
		<ul class="posts">
			<ChildBlogPost url="/ja/posts/photos/2026-11-05_joshin-ji/" title="Photos: 九品仏浄真寺 (2024年冬)" published="2026-11-05"/>
			<ChildBlogPost url="/ja/posts/music/2026-11-04_favorite_songs/" title="死ぬ前にもういちど聞いておきたい曲リスト（つまりお気に入り）" published="2026-11-04"/>
			<ChildBlogPost url="/ja/posts/personal/2026-11-03_junior_high_school_era/" title="中学時代、荒れてたとこにいたんだよねー、っていう話をするのが楽しい。あれ、なんで？" published="2026-11-03"/>
		</ul>
		<a class="link-to-posts no-decoration" href="/ja/posts/">
			<Image src={seeAllPostsImage} alt="もっと見る" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li>森見登美彦『走れメロス』</li>
				<li>永井玲衣『これがそうなのか』</li>
				<li>コーマック・マッカーシー『ザ・ロード』</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-album">Albums & EPs</h3>
			<ul>
				<li>H2O - Daryl Hall & John Oates</li>
				<li>tomorrow - 川西拓実</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>ラブリーズン - 原因は自分にある。</li>
				<li>いいんじゃない - muque</li>
				<li>Hands On Me - Maisie Peters</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-tv">ドラマ</h3>
			<ul>
				<li>『南田南弁護士は天才肌』(<span style="font-style: italic;">Extraordinary Attorney Minami</span>)</li>
				<li>『メリーベリーラブ』(<span style="font-style: italic;">Merry Berry Love</span>)</li>
				<li>『修学旅行で仲良くないグループに入りました2 』(<span style="font-style: italic;">School Trip: Joined a Group I'm Not Close To Season 2</span>)</li>
				<li>『青と碧』(<span style="font-style: italic;">Ao to Midori</span>)</li>
			</ul>
		</div>
		<!-- <div class="recently-child">
			<h3 class="icon-movie">映画</h3>
			<ul>
				<li>Backrooms</li>
			</ul>
		</div> -->
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayoutNoNavJa>