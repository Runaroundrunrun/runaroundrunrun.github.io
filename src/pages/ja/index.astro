---
import BaseLayoutNoNavJa from "../../layouts/ja/BaseLayoutNoNavJa.astro";
import ChildBlogPost from "../../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "../images/see_all_posts_jpn.png";
import "../../styles/index.css";

const pageTitle = "Home";
const currentJaPage = "/";
---
<BaseLayoutNoNavJa pageTitle={pageTitle} currentPage={currentJaPage}>
	<div id="menu" class="index-content">
		<div class="menu-wrap">
			<a class="" href="/ja/posts/">Posts & Notes</a>
			<a class="" href="/ja/links/">Links</a>
			<a class="" href="/ja/about/">About</a>
		</div>
	</div>
	<div id="latest" class="index-content">
		<h2>更新履歴</h2>
		<ul class="posts">
			<ChildBlogPost url="/ja/posts/reading/2026-10-09_life_is_anywhere_door/" title="旅のお供にしたい『人生はどこでもドア』" published="2026-10-09"/>
			<ChildBlogPost url="/ja/posts/writing/2026-10-08_why_I_write/" title="なぜ書くのか？そもそも書くことを好きなのか？" published="2026-10-08"/>
			<ChildBlogPost url="/ja/posts/movies/2026-10-02_backrooms/" title="良かったけど、ひどい画面酔いになった：『バックルームズ』" published="2026-10-02"/>
		</ul>
		<a class="link-to-posts no-decoration" href="/ja/posts/">
			<Image src={seeAllPostsImage} alt="もっと見る" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li>伊藤紺著『わたしのなかの巨大な星』</li>
				<li>森見登美彦著『夜は短し歩けよ乙女』</li>
				<li>三田三郎著『精神はもっと猫背』</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-album">Albums & EPs</h3>
			<ul>
				<li>AMAZONIA - ONE N' ONLY</li>
				<li>Brotherhood - New Order</li>
				<li>The Walls Are Way Too Thin - Holly Humberstone</li>
				<li>ANIMAL - JO1</li>
				<li>Something We All Got - cootie catcher</li>
				<li>Dear You - Jawbreaker</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>GIVE ME FIVE - 川西拓実</li>
				<li>月とあたしと冷蔵庫 - 緑黄色社会</li>
				<li>愛せ、至極散々な僕らの日を - ONE LOVE ONE HEART</li>
				<li>NPC - SUPER ★ DRAGON</li>
				<li>Sex and the city - Audrey Hobert</li>
				<li>結び - Ayumu Imazu</li>
				<li>Chain Reaction - Matilda Mann</li>
				<li>Haunt Me - Matilda Mann</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="">ドラマ</h3>
			<ul>
				<li><a href="/ja/posts/tv-series/2026-09-30_popular_serizawa_acts_weird/">陽キャ集団にいる芹沢は、俺の前だと様子がおかしい</a></li>
			</ul>
		</div>
		<!-- <div class="recently-child">
			<h3 class="icon-movie">映画</h3>
			<ul>
				<li>Backrooms</li>
			</ul>
		</div> -->
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayoutNoNavJa>