---
import BaseLayout from "../layouts/BaseLayout.astro"
import ChildBlogPost from "../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "./images/see_all_posts.png";
import "../styles/index.css";

const pageTitle = "Home";
const currentPage ="/";
---
<BaseLayout pageTitle={pageTitle} currentPage={currentPage}>
	<div id="latest" class="index-content">
		<h2>Latest</h2>
		<ul class="posts">
			<ChildBlogPost url="/posts/gaming/2026-09-07_dave_the_diver/" title="DAVE THE DIVER: very satisfying game!" published="2026-09-07"/>
			<ChildBlogPost url="/posts/drawing/2026-09-04_sketches/" title="Sketches (August 1 - August 11)" published="2026-09-04"/>
			<ChildBlogPost url="/posts/lifelog/2026/2026_august_media_log/" title="Media Log (August 2026)" published="2026-08-30"/>
		</ul>
		<a class="link-to-posts no-decoration" href="/posts/">
			<Image src={seeAllPostsImage} alt="see all posts" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li>『量子力学で生命の謎を解く』
					<br>Japanese version of <span style="font-style: italic;">Life on the Edge: The Coming of Age of Quantum Biology</span> by Jim Al-Khalili, Johnjoe McFadden
				</li>
				<li>『すべてはノートからはじまる　あなたの人生をひらく記録術』</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-album">Albums</h3>
			<ul>
				<li>Take Good Care - The Revivalists</li>
				<li>Kismet - Matilda Mann</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>世界はそれを愛と呼ぶんだぜ - サンボマスター</li>
				<li>Funeral - Ashe</li>
				<li>ハルコイ - DXTEEN</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="">TV series</h3>
			<ul>
				<li>修学旅行で仲良くないグループに入りました</li>
				<li>陽キャ集団にいる芹沢は、俺の前だと様子がおかしい</li>
				<li>当我飞奔向你 (When I Fly Towards You)</li>
			</ul>
		</div>
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayout>