---
import BaseLayoutJa from "../../layouts/ja/BaseLayoutJa.astro"
import ChildBlogPost from "../../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "../images/see_all_posts_jpn.png";
import "../../styles/index.css";

const pageTitle = "Home";
const currentJaPage = "/";
---
<BaseLayoutJa pageTitle={pageTitle} currentPage={currentJaPage}>
	<div id="latest" class="index-content">
		<h2>更新履歴</h2>
		<ul class="posts">
			<ChildBlogPost url="/ja/posts/reading/2026-07-01_books_I_want_to_read" title="読みたい本リスト" published="2026-07-01" />
			<ChildBlogPost url="/ja/posts/web-dev/2026-06-30_my_current_vscode_keybindings_configuration" title="今のVSCodeのkeybindings設定" published="2026-06-30"/>
			<ChildBlogPost url="/ja/posts/photos/2026-06-29_art_aquarium_museum" title="Photos: アートアクアリウム美術館" published="2026-06-29" />
		</ul>
		<a class="link-to-posts no-decoration" href="/ja/posts/chronological">
			<Image src={seeAllPostsImage} alt="もっと見る" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-album">Albums</h3>
			<ul>
				<li>Florescense - Masie Peters</li>
				<li>Good Boys... When They're Asleep - Faces</li>
			</ul>
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>Wanna Buy A Plant + Cost Me - JO1, Anderson .Paak</li>
				<li>景色 - JO1.VER - JO1</li>
				<li>doomsday - Lizzy McAlpine</li>
				<li>Bittersweet - Matilda Mann</li>
				<li>A QUEDA - Gloria Groove</li>
				<li>The Gambler - fun.</li>
				<li>You Can't Always Get What You Want - The Rolling Stones</li>
				<li>I Shall Be Released - Bob Dylan</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3>Netflix Series</h3>
			<ul>
				<li>ザ・ボローズ</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3>YouTube</h3>
			<ul>
				<li>Backrooms - Kane Pixels</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li>『火星の人』</li>
				<li>『メモを取れば財産になる』</li>
				<li>『脱力、台湾式。』</li>
			</ul>
		</div>
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayoutJa>