---
import BaseLayout from "../layouts/BaseLayout.astro"
import ChildBlogPost from "../components/ChildBlogPost.astro";
const pageTitle = "Home"
---
<BaseLayout pageTitle={pageTitle}>
	<div class="lang-switch">
		<a href="/ja/">にほんご / Japanese</a>
	</div>
	<div id="latest" class="index-content">
		<h2>Latest</h2>
		<ul class="posts">
			<ChildBlogPost url="/posts/lifelog/2026/2026_may_media_log" title="Media Log (May 2026)" published="2026-06-03"/>
			<ChildBlogPost url="/posts/technical/2026-05-30_keyboard_shortcuts" title="Keyboard shortcuts I use" published="2026-05-30"/>
			<ChildBlogPost url="/posts/crafting/2026-05-26_decorating_notebook_covers" title="Decorating notebook covers" published="2026-05-26" />
		</ul>
		<a href="/posts/by-date/">and more...</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-music">Music</h3>
			<ul>
				<li class="icon-album">Albums</li>
					<ul>
						<li>Florescense - Masie Peters</li>
					</ul>
				<li>Songs</li>
				<ul>
					<li>Wanna Buy A Plant + Cost Me - JO1, Anderson .Paak</li>
					<li>景色 - JO1.VER - JO1</li>
					<li>doomsday - Lizzy McAlpine</li>
				</ul>
			</ul>
		</div>
		<div class="recently-child">
			<h3>Netflix Series</h3>
			<ul>
				<li>The Boroughs</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li>The Martian</li>
			</ul>
		</div>
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayout>