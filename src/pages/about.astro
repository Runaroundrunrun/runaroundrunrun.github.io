---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import profileImage from "./images/profile.png";
import "../styles/about.css";

const pageTitle = "About";
const currentPage = "/about/";
---

<BaseLayout pageTitle={pageTitle} currentPage={currentPage}>
    <h1>{pageTitle}</h1>
    <div class="about-container">
        <h2>Welcome to Runa's Playground!</h2>
        <span>I'm trying to make this website:</span>
        <ul>
            <li>a place where I can have fun, explore, and experiment</li>
            <li>a repository for the things I create and write</li>
        </ul>
    </div>
    <div class="profile-container about-container">
        <Image src={profileImage} alt="profile image" layout="constrained"/>
        <div class="profile-description">
            <h2>Runa</h2>
            <ul>
                <li>loves exploring, travelling, reading, and journaling</li>
                <li>currently on a career break (formerly coder)</li>
                <li>lives in Japan</li>
                <li>
                    is always interested in learning languages currently
                    learning:
                    <ul>
                        <li>English</li>
                        <li>French</li>
                        <li>Chinese</li>
                    </ul>
                </li>
                <li>trying to act like a responsible adult</li>
                <li>but often end up being a procrastinator</li>
                <li>wants to learn how to draw</li>
            </ul>
        </div>
    </div>
    <div class="about-container">
        <h3>Contact</h3>
        <p class="icon-mail">suzuki-runa@proton.me</p>
    </div>
</BaseLayout>
