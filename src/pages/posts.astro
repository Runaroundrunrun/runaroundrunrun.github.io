---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChildBlogPost from "../components/ChildBlogPost.astro";
const pageTitle = "Posts and Notes";
const currentPage = "/posts/";
---

<BaseLayout pageTitle={pageTitle} currentPage={currentPage}>
    <h1>{pageTitle}</h1>
    <p>
        A collection of my thoughts, logs, and letters to a new friend.<br />
        I treat this page like a digital garden, so some posts here may be incomplete
        or a work in progress. <br />
        I might also rewrite or rephrase from time to time.
    </p>
    <div class="categories-and-posts">
        <aside class="categories">
            <nav>
                <h4>Categories</h4>
                <ul>
                    <li><a href="#crafting">Crafting</a></li>
                    <li><a href="#lifelog">Lifelog</a></li>
                    <li><a href="#reading">Reading</a></li>
                    <li><a href="#tv-series">TV series</a></li>
                    <li><a href="#website-dev">Website Development</a></li>
                    <li><a href="#writing">Writing</a></li>
                </ul>
            </nav>
        </aside>
        <div class="posts-container">
            <div id="crafting" class="posts-category">
                <h3>Crafting</h3>
                <ul class="posts">
                    <ChildBlogPost
                        url="/posts/crafting/2026-05-26_decorating_notebook_covers"
                        title="Decorating notebook covers"
                        published="2026-05-26"
                        modified="2026-06-06"
                    />
                </ul>
            </div>
            <div id="lifelog" class="posts-category">
                <h3>Lifelog</h3>
                <ul class="posts">
                    <ChildBlogPost
                        url="/posts/lifelog/2026/2026_may_media_log"
                        title="Media Log (May 2026)"
                        published="2026-06-03"
                        modified="2026-06-13"
                    />
                </ul>
            </div>
            <div id="reading" class="posts-category">
                <h3>Reading</h3>
                <ul class="posts">
                    <ChildBlogPost
                        url="/posts/reading/2026-06-21_books_I_want_to_read"
                        title="A list of books I've been wanting to read"
                        published="2026-06-21"
                    />
                    <ChildBlogPost
                        url="/posts/reading/2026-06-12_project_hail_mary"
                        title="The most exciting sci-fi I've ever read: Project Hail Mary"
                        published="2026-06-12"
                        modified="2026-06-19"
                    />
                    <ChildBlogPost
                        url="/posts/reading/2026-05-16_I_buy_way_more_books_than_I_can_read"
                        title="I buy way more books than I can read"
                        published="2026-05-16"
                    />
                </ul>
            </div>
            <div id="technical">
                <h3>Technical</h3>
                <ul class="posts">
                    <ChildBlogPost
                        url="/posts/technical/2026-05-30_keyboard_shortcuts"
                        title="Keyboard shortcuts I use"
                        published="2026-05-30"
                        modified="2026-06-12"
                    />
                </ul>
            </div>
            <div id="tv-series" class="posts-category">
                <h3>TV series</h3>
                <ul class="posts">
                    <ChildBlogPost
                        url="/posts/tv-series/2026-05-13_yumis_cells3"
                        title="I haven't felt this happy watching a Korean series - 유미의 세포들 3 (Yumi's Cells 3)"
                        published="2026-05-13"
                        modified="2026-06-13"
                    />
                </ul>
            </div>
            <div id="website-dev" class="posts-category">
                <h3>Website Development</h3>
                <ul class="posts">
                    <ChildBlogPost
                        url="/posts/web-dev/2026-06-25_adding_categories_section"
                        title="Adding &quot;categories&quot; section to Posts and Notes page"
                        published="2026-06-25"
                    />
                    <ChildBlogPost
                        url="/posts/web-dev/2026-05-20_features_to_add"
                        title="Features I want to add to this website"
                        published="2026-05-20"
                        modified="2026-06-25"
                    />
                    <ChildBlogPost
                        url="/posts/web-dev/2026-05-12_my_current_vscode_keybindings_configuration"
                        title="My current keybindings configuration in VSCode"
                        published="2026-05-12"
                        modified="2026-06-06"
                    />
                    <ChildBlogPost
                        url="/posts/web-dev/2026-05-08_on_setting_up_this_website"
                        title="On setting up this website"
                        published="2026-05-08"
                        modified="2026-06-06"
                    />
                </ul>
            </div>
            <div id="writing" class="posts-category">
                <h3>Writing</h3>
                <ul class="posts">
                    <ChildBlogPost
                        url="/posts/writing/2026-06-17_making_writing_easier"
                        title="How can I make writing easier?"
                        published="2026-06-17"
                    />
                </ul>
            </div>
        </div>
    </div>
</BaseLayout>
