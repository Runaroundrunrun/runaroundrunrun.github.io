---
import BaseLayout from "../layouts/BaseLayout.astro"
import ChildBlogPost from "../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "./images/see_all_posts.png";
import "../styles/index.css";

const pageTitle = "Home";
const currentPage ="/";
---
<BaseLayout pageTitle={pageTitle} currentPage={currentPage}>
	<div id="latest" class="index-content">
		<h2>Latest</h2>
		<ul class="posts">
            <ChildBlogPost url="/posts/photos/2026-06-26_art_aquarium_museum" title="Photos: Art Aquarium Museum" published="2026-06-26" />
			<ChildBlogPost url="/posts/web-dev/2026-06-25_adding_categories_section" title="Adding &quot;categories&quot; section to Posts and Notes page" published="2026-06-25"/>
			<ChildBlogPost url="/posts/reading/2026-06-21_books_I_want_to_read" title="A list of books I've been wanting to read" published="2026-06-21"/>
		</ul>
		<a class="link-to-posts no-decoration" href="/posts/chronological/">
			<Image src={seeAllPostsImage} alt="see all posts" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-album">Albums</h3>
			<ul>
				<li>Florescense - Masie Peters</li>
				<li>Good Boys... When They're Asleep - Faces</li>
			</ul>
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>Wanna Buy A Plant + Cost Me - JO1, Anderson .Paak</li>
				<li>景色 - JO1.VER - JO1</li>
				<li>doomsday - Lizzy McAlpine</li>
				<li>Bittersweet - Matilda Mann</li>
				<li>A QUEDA - Gloria Groove</li>
				<li>The Gambler - fun.</li>
				<li>You Can't Always Get What You Want - The Rolling Stones</li>
				<li>I Shall Be Released - Bob Dylan</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3>Netflix Series</h3>
			<ul>
				<li>The Boroughs</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3>YouTube</h3>
			<ul>
				<li>Backrooms by Kane Pixels</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li>The Martian</li>
				<li>How to Take Smart Notes: One Simple Technique to Boost Writing, Learning and Thinking for Students, Academics and Nonfiction Book Writers</li>
			</ul>
		</div>
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayout>