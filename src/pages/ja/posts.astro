---
import BaseLayoutJa from "../../layouts/ja/BaseLayoutJa.astro";
import ChildBlogPost from "../../components/ChildBlogPost.astro";
import type { MarkdownInstance } from 'astro';

interface Frontmatter {
    layout: string,
    title: string,
    published: string,
    modified?: string,
    lang: string,
    category?: string
}

const pageTitle = "Posts and Notes";
const currentJaPage = "/posts/"

const allPosts = Object.values(import.meta.glob<MarkdownInstance<Frontmatter>>('./posts/**/*.md', { eager: true }));
// sort by published date (desc)
const sortedPosts = allPosts.sort((a: any, b: any) => a.frontmatter.published > b.frontmatter.published ? -1 : 1);
const byCategory = Map.groupBy(sortedPosts, (post) => {return post.frontmatter.category as string});
const categoryDispMap: Record<string, string> = {
    "cooking" : "料理",
    "crafting" : "ハンドクラフト",
    "lifelog" : "ライフログ",
    "photos" : "写真",
    "reading" : "読書",
    "technical" : "Tech",
    "web-dev" : "Webサイト開発"
};
// 日本語の昇順に並べる
const categories = [...byCategory.keys()].sort((a, b) => categoryDispMap[a].localeCompare(categoryDispMap[b], 'ja'));
const categoryIconMap: Record<string, string> = {
    "crafting" : "",
    "lifelog" : "",
    "music" : "icon-music",
    "photos" : "icon-camera",
    "reading" : "icon-books",
    "technical" : "",
    "tv-series" : "",
    "web-dev" : "",
    "cooking" : "",
};
---

<BaseLayoutJa pageTitle = {pageTitle} currentPage = {currentJaPage}>
    <h1>{pageTitle}</h1>
    <p class="description">
        考えていること、やったことなどをここに集めています。<br>
        デジタルガーデンみたいにしたいと思っているので、ここにあるものは未完成だったり、作業中の可能性があります。<br>
        時折編集したりするかも。
    </p>
    <div class="categories-and-posts">
        <aside class="categories">
            <nav>
                <h4>Categories</h4>
                <ul>
                    {categories.map(category => 
                        <li><a href={`#${category}`}>{categoryDispMap[category]}</a></li>
                    )}
                </ul>
            </nav>
        </aside>
        <div class="posts-container">
            {categories.map(category => {
                return (
                    <div id={category} class="posts-category">
                        <h3 class={categoryIconMap[category]}>{categoryDispMap[category]}</h3>
                        <ul class="posts">
                            {byCategory.get(category)?.map(
                                (post) => {return (
                                    <ChildBlogPost url={post.url} title={post.frontmatter.title} published={post.frontmatter.published} modified={post.frontmatter.modified}/>   
                                )}
                            )}
                        </ul>
                    </div>
                )
            })}
        </div>
    </div>
</BaseLayoutJa>
