---
import BaseLayoutJa from "../../layouts/ja/BaseLayoutJa.astro"
import ChildBlogPost from "../../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "../images/see_all_posts_jpn.png";
import "../../styles/index.css";

const pageTitle = "Home"
---
<BaseLayoutJa pageTitle={pageTitle}>
	<div class="lang">
		<a href="/">English</a>
	</div>
	<div id="latest" class="index-content">
		<h2>更新履歴</h2>
		<ul class="posts">
			<ChildBlogPost url="/ja/posts/reading/2026-06-19_project_hail_mary" title="今まで読んだSFの中で、いちばんワクワクした作品：『プロジェクト・ヘイル・メアリー』" published="2026-06-19" />
			<ChildBlogPost url="/ja/posts/web-dev/2026-06-13_deciding_to_use_github_and_astro" title="Webサイト立ち上げの記録 (1) - 利用するサービス・ツールを決める" published="2026-06-13" />
			<ChildBlogPost url="/ja/posts/web-dev/2026-06-10_setting_iframe_css" title="画面を縮小したら親要素から動画がはみ出る問題の対応" published="2026-06-10" />
		</ul>
		<a class="link-to-posts no-decoration" href="/ja/posts/chronological">
			<Image src={seeAllPostsImage} alt="もっと見る" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-album">Albums</h3>
			<ul>
				<li>Florescense - Masie Peters</li>
			</ul>
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>Wanna Buy A Plant + Cost Me - JO1, Anderson .Paak</li>
				<li>景色 - JO1.VER - JO1</li>
				<li>doomsday - Lizzy McAlpine</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3>Netflix Series</h3>
			<ul>
				<li>ザ・ボローズ</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3>YouTube</h3>
			<ul>
				<li>Backrooms - Kane Pixels</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li>『火星の人』</li>
				<li>『メモを取れば財産になる』</li>
			</ul>
		</div>
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayoutJa>