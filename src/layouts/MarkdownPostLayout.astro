---
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
const visibility = frontmatter.modified != null ? "" : "invisible";
---
<BaseLayout pageTitle = {frontmatter.title}>
    <article>
        <span class="date">
            <p>Published: <time>{frontmatter.published.toString().slice(0,10)}</time></p>
            <p class={visibility}>Last modified: <time>{frontmatter.modified?.toString().slice(0,10)}</time></p>
        </span>
        <!-- <div>tags</div> -->
        <hr>
        <div class="content-container">
            <slot />   
        </div>
    </article>
</BaseLayout>