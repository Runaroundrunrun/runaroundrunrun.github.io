---
import BaseLayoutJa from "../../layouts/ja/BaseLayoutJa.astro";
import ChildBlogPost from "../../components/ChildBlogPost.astro";
const pageTitle = "Posts and Notes";
const currentJaPage = "/posts/"
---

<BaseLayoutJa pageTitle = {pageTitle} currentPage = {currentJaPage}>
    <h1>{pageTitle}</h1>
    <p>
        考えていること、やったことなどをここに集めています。<br>
        デジタルガーデンみたいなイメージなので、ここにあるものは未完成だったり、作業中の可能性があります。<br>
        時折編集したりするかも。
    </p>
    <div class="categories-and-posts">
        <aside class="categories">
            <nav>
                <h4>Categories</h4>
                <ul>
                    <li><a href="#technical">Tech</a></li>
                    <li><a href="#website-dev">Webサイト開発</a></li>
                    <li><a href="#reading">読書</a></li>
                    <!-- <li><a href="#tv-series">ドラマ</a></li> -->
                    <li><a href="#crafting">ハンドクラフト</a></li>
                    <li><a href="#lifelog">ライフログ</a></li>                    
                </ul>
            </nav>
        </aside>
        <div class="posts-container">
            <div id="technical">
                <h3>Tech</h3>
                <ul class="posts">
                    <ChildBlogPost url="/ja/posts/technical/2026-06-06_keyboard_shortcuts" title="使っているショートカットキー" published="2026-06-06"/>
                </ul>
            </div>
            <div id="website-dev" class="posts-category">
                <h3>Webサイト開発</h3>
                <ul class="posts">
                    <ChildBlogPost url="/ja/posts/web-dev/2026-06-21_install_nodejs_and_astro" title="Webサイト立ち上げの記録 (2) - Astro を使う準備" published="2026-06-21" />
                    <ChildBlogPost url="/ja/posts/web-dev/2026-06-13_deciding_to_use_github_and_astro" title="Webサイト立ち上げの記録 (1) - 利用するサービス・ツールを決める" published="2026-06-13" />
                    <ChildBlogPost url="/ja/posts/web-dev/2026-06-10_setting_iframe_css" title="画面を縮小したら親要素から動画がはみ出る問題の対応" published="2026-06-10" />
                    <ChildBlogPost url="/ja/posts/web-dev/2026-05-30_features_to_add" title="このサイトに加えたい機能" published="2026-05-30" />
                    <ChildBlogPost url="/ja/posts/web-dev/2026-05-20_on_setting_up_this_website" title="ウェブサイトを立ち上げてみた" published="2026-05-20" modified="2026-06-13"/>
                </ul>
            </div>
            <div id="reading" class="posts-category">
                <h3>読書</h3>
                <ul class="posts">
                    <ChildBlogPost url="/ja/posts/reading/2026-06-19_project_hail_mary" title="今まで読んだSFの中で、いちばんワクワクした作品：『プロジェクト・ヘイル・メアリー』" published="2026-06-19" />
                </ul>
            </div>
            <!-- <div id="tv-series" class="posts-category">
                <h3>ドラマ</h3>
                <ul class="posts">
                    <ChildBlogPost url="/posts/tv-series/2026-05-13_yumis_cells3" title="I haven't felt this happy watching a Korean series - 유미의 세포들 3 (Yumi's Cells 3)" published="2026-05-13" modified="2026-05-24" />
                </ul>
            </div> -->
            <div id="crafting" class="posts-category">
                <h3>ハンドクラフト</h3>
                <ul class="posts">
                    <ChildBlogPost url="/ja/posts/crafting/2026-06-06_decorating_notebook_covers" title="ノートデコのススメ" published="2026-06-06" />
                </ul>
            </div>
            <div id="lifelog" class="posts-category">
                <h3>ライフログ</h3>
                <ul class="posts">
                    <ChildBlogPost url="/ja/posts/lifelog/2026/2026_may_media_log" title="2026年5月に楽しんだ作品リスト" published="2026-06-06" modified="2026-06-19"/>
                </ul>
            </div>
        </div>
    </div>
</BaseLayoutJa>
