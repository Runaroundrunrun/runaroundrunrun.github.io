---
import BaseLayoutJa from "../../layouts/ja/BaseLayoutJa.astro"
import ChildBlogPost from "../../components/ChildBlogPost.astro";
import { Image } from 'astro:assets';
import seeAllPostsImage from "../images/see_all_posts_jpn.png";
import "../../styles/index.css";

const pageTitle = "Home";
const currentJaPage = "/";
---
<BaseLayoutJa pageTitle={pageTitle} currentPage={currentJaPage}>
	<div id="latest" class="index-content">
		<h2>更新履歴</h2>
		<ul class="posts">
			<ChildBlogPost url="/ja/posts/lifelog/2026-09-11_film_camera/" title="お気に入り: フィルムカメラ Kodak M38" published="2026-09-11"/>
			<ChildBlogPost url="/ja/posts/stationery/2026-09-07_sokuryo_yacho/" title="コクヨ 測量野帳 - 持ち運びにピッタリのノート" published="2026-09-07"/>
			<ChildBlogPost url="/ja/posts/lifelog/2026-09-05_dxteen/" title="DXTEEN（と修仲）が気になる今日この頃" published="2026-09-05"/>
		</ul>
		<a class="link-to-posts no-decoration" href="/ja/posts/">
			<Image src={seeAllPostsImage} alt="もっと見る" layout="constrained"/>
		</a>
	</div>
	<div id="recently" class="index-content">
		<h2>Recently</h2>
		<div class="recently-child">
			<h3 class="icon-books">Books</h3>
			<ul>
				<li>ジム・アル＝カリーリ、ジョンジョー・マクファデン著『量子力学で生命の謎を解く』</li>
				<li>倉下忠憲著『すべてはノートからはじまる　あなたの人生をひらく記録術』</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-album">Albums</h3>
			<ul>
				<li>Take Good Care - The Revivalists</li>
				<li>Kismet - Matilda Mann</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="icon-music">Songs</h3>
			<ul>
				<li>世界はそれを愛と呼ぶんだぜ - サンボマスター</li>
				<li>Funeral - Ashe</li>
				<li>ハルコイ - DXTEEN</li>
			</ul>
		</div>
		<div class="recently-child">
			<h3 class="">ドラマ</h3>
			<ul>
				<li>修学旅行で仲良くないグループに入りました</li>
				<li>陽キャ集団にいる芹沢は、俺の前だと様子がおかしい</li>
				<li>当我飞奔向你 (「向日葵を追いかける太陽」)</li>
			</ul>
		</div>
	</div>
	<!-- <div id="collections">

	</div> -->
</BaseLayoutJa>